{
  "display_information": {
    "name": "AgentSCM"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "AgentSCM",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://example.invalid/v1/hub/slack",
      "bot_events": [
        "tokens_revoked",
        "app_uninstalled"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://example.invalid/v1/hub/slack"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
