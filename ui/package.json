{
  "name": "agentscm-status-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Status page and workspace UI served by the AgentSCM coordination hub at /ui/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && tsc -b && vitest run && playwright test",
    "lint": "eslint . --max-warnings 0 && node --experimental-strip-types scripts/check-derive.mjs && npm run test:connect-agent && npm run test:workspace && npm run test:standup",
    "test:connect-agent": "node --experimental-strip-types scripts/check-connect-agent.mjs",
    "test:workspace": "node --experimental-strip-types scripts/check-workspace.mjs",
    "test:standup": "node --experimental-strip-types scripts/check-standup.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bootstrap": "^5.2.10",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
